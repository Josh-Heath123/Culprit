# Culprit agent — systemd recipe (Phase 33 part 3).
#
# One agent per machine. It opens no port and reaches its control plane
# only outbound, over https. It runs as a transient, unprivileged user
# (DynamicUser) with the whole filesystem read-only to it except its own
# state directory, where its audit log lives (/var/lib/culprit-agent). The
# control plane holds the same hash chain, so the log must outlive restarts:
# StateDirectory does.
#
# The key is a credential: systemd copies /etc/culprit/agent.key into
# /run/credentials/culprit-agent.service/agent.key for this service alone,
# readable by its user only and by no other process. agent.yaml names that
# path:
#
#   key: /run/credentials/culprit-agent.service/agent.key
#
# Setup (deploy/agent/README.md has every step):
#   install -m 0755 culprit /usr/local/bin/culprit
#   install -d -m 0755 /etc/culprit
#   install -m 0644 agent.yaml culprit.yaml /etc/culprit/
#   key: written by `culprit agent init`, then moved to /etc/culprit/agent.key, 0600 root
#   install -m 0644 culprit-agent.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now culprit-agent
#
# CI checks this unit with `systemd-analyze verify` (`just agent-recipes`).

[Unit]
Description=Culprit agent: read-only probes, under its own grants
Documentation=https://github.com/Josh-Heath123/Culprit/blob/main/deploy/agent/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/culprit agent --config /etc/culprit/agent.yaml --audit /var/lib/culprit-agent/audit.log
LoadCredential=agent.key:/etc/culprit/agent.key
DynamicUser=yes
StateDirectory=culprit-agent
StateDirectoryMode=0700
Restart=on-failure
RestartSec=10s

# The agent reads its configuration and writes only its audit log.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
