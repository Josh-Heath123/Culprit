# Python
__pycache__/
*.py[cod]
.venv/
.venv2/
.pytest_cache/
.ruff_cache/
.venv2/

# uv
.python-version

# Env / secrets
.env
.env.*
!.env.example
!.env.prod.example

# Phase 24 (docs/AI_NATIVE_PLAN.md): a local Claude Code MCP registration
# for mcp_server/ can embed MCP_READER_DATABASE_URL/VOYAGE_API_KEY
# directly in its own `env` block (see
# docs/AI_NATIVE_INSTRUMENTATION.md) — never committed, same reasoning
# as .env above.
.mcp.json

# Node / frontend
node_modules/
dist/

# Generated from api's live OpenAPI schema (`just generate-types`) —
# regenerated on every frontend dev/build, never hand-edited or committed.
frontend/openapi.schema.json
frontend/src/lib/api-types.generated.ts

# Editors / OS
.vscode/
.idea/
.DS_Store

# scripts/backup.sh's default output — database dumps, never committed.
/backups/

# Claude Code personal settings — per-developer, never shared
.claude/settings.local.json

# Phase 28: the extractor fixture corpus is *input data*, and running an
# extractor against it imports the fixture -- which leaves __pycache__ and,
# for the vendored Flask tutorial, a Flask `instance/` directory holding a
# SQLite database. Neither is part of the fixture, and committing either
# would stop a vendored upstream tree being a faithful copy of upstream.
cli/testdata/fixtures/**/instance/

# Phase 28: Go build output. `just cli-build` writes cli/bin/ and
# `just cli-release` writes cli/dist/ (covered by `dist/` above). A 4 MB
# binary in the repository is one that goes stale the moment anyone
# edits cli/ without rebuilding.
cli/bin/

# Phase 29: `culprit check --format sarif --output culprit.sarif`, and the
# `just self-check-sarif` recipe that writes it. A build artefact CI
# uploads, not source. `.gobuildtmp/` is a GOTMPDIR escape hatch for
# machines whose antivirus objects to linking in the system temp dir.
culprit.sarif
cli/.gobuildtmp/
