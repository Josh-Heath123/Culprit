{
  "permissions": {
    "allow": [
      "Bash(just:*)",
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(npm run:*)",
      "Bash(npm ci)",
      "Bash(npm install:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go run:*)",
      "Bash(go vet:*)",
      "Bash(gofmt:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git fetch:*)",
      "Bash(docker compose:*)",
      "Bash(docker build:*)",
      "Bash(docker logs:*)",
      "Bash(docker ps:*)",
      "Bash(gh run:*)",
      "Bash(gh api:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh workflow view:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)"
    ],
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",
      "Bash(docker compose -f infra/docker-compose.prod.yml:*)",
      "Edit(infra/.env*)",
      "Edit(.github/workflows/*)"
    ],
    "deny": [
      "Read(./infra/.env)",
      "Read(./infra/.env.prod)",
      "Read(./api/.env)",
      "Read(./worker/.env)",
      "Read(./demo-services/.env)",
      "Read(./frontend/.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/.ssh/**)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume rm:*)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(gh pr merge --admin:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/capture_ai_change.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check_invariants.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/fast_gates.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
