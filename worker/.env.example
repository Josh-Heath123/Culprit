DATABASE_URL=postgresql+asyncpg://ingestion-writer:change-me-ingestion-writer@localhost:5432/signalstack
REDIS_URL=redis://localhost:6379

# Phase 4: anomaly detection — separate least-privilege role (SELECT
# raw_events, INSERT anomalies), distinct from ingestion-writer above.
ANOMALY_DATABASE_URL=postgresql+asyncpg://anomaly-detector:change-me-anomaly-detector@localhost:5432/signalstack

# Phase 5: correlation engine — SELECT anomalies, SELECT/INSERT/UPDATE
# incident_candidates, SELECT/INSERT incident_anomalies.
CORRELATION_DATABASE_URL=postgresql+asyncpg://correlation-engine:change-me-correlation-engine@localhost:5432/signalstack

# Phase 6: RAG + root-cause narrative — SELECT raw_events/anomalies/
# incident_anomalies, SELECT/UPDATE incident_candidates, SELECT/INSERT/
# UPDATE postmortems (also used by scripts/seed_postmortems.py).
ROOT_CAUSE_DATABASE_URL=postgresql+asyncpg://root-cause-writer:change-me-root-cause-writer@localhost:5432/signalstack

# Phase 31: probe-writer — INSERT on readings and nothing else. The
# anomaly job emits an impedance reading alongside each anomaly it
# writes, and does it under this role rather than anomaly-detector's:
# a reading is the OBSERVED plane, not an anomaly row.
PROBE_WRITER_DATABASE_URL=postgresql+asyncpg://probe-writer:change-me-probe-writer@localhost:5432/signalstack

# Phase 35 part 2: narrator — SELECT on the investigation tables and its own
# narrations, INSERT on narrations. Required even with narration off.
NARRATOR_DATABASE_URL=postgresql+asyncpg://narrator:change-me-narrator@localhost:5432/signalstack
# none (default), anthropic or ollama — app/narrate/config.py.
LLM_PROVIDER=none
NARRATOR_MODEL=
OLLAMA_URL=

# Server-side only, per CLAUDE.md — never sent to the frontend.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=change-me-voyage-api-key

# Phase 10: self-observability — OTel traces to Tempo (infra/docker-compose.yml).
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318
