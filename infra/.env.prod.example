# Production secrets for docker-compose.prod.yml — copy this to
# `.env.prod` ON THE VM ONLY (never commit the real file, never put
# these values in GitHub Actions secrets). Created once, by hand, per
# Phase 11's security requirement: the only secret CI itself needs is
# the SSH deploy key. Named .env.prod, not .env — see
# docker-compose.prod.yml's header comment for why that distinction
# actually matters here, not just style.
#
# Generate random passwords with e.g.:
#   openssl rand -base64 32
# Generate the argon2 hash for OPERATOR_PASSWORD_HASH with (from worker/ or api/):
#   uv run python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('your-password'))"
#
# IMPORTANT — escape every literal `$` in a value as `$$`. Docker
# Compose's env_file loader runs the same ${VAR} interpolation on these
# values that it runs on the compose YAML itself, so an unescaped `$` is
# silently read as the start of a variable reference (usually undefined,
# so it's silently dropped) rather than a literal character. This is not
# hypothetical: argon2 hashes are $-delimited by format
# ($argon2id$v=19$...), so OPERATOR_PASSWORD_HASH below WILL get
# corrupted into an invalid hash if you paste one in unescaped — verified
# by hitting exactly this while testing this file locally. Escaped
# example: `$argon2id$v=19$...` becomes `$$argon2id$$v=19$$...`.



# ---- Postgres superuser (also used by api/migrations/env.py for `alembic upgrade head`) ----
# "culprit", not "signalstack" -- a fresh install (this file's defaults)
# uses the product name. The LIVE culprit.co.za database is still
# literally named "signalstack" (it predates the product being named
# Culprit) and renaming it is a data migration, not a config edit -- see
# docs/SELF_HOSTED_PLAN.md Phase 17 Known Trap 2 and docs/INSTALL.md.
# Never change the values already in the real infra/.env.prod on that VM
# to match this file.
POSTGRES_USER=culprit
POSTGRES_PASSWORD=change-me-postgres-superuser
POSTGRES_DB=culprit
DASHBOARD_DATABASE_URL=postgresql+asyncpg://culprit:change-me-postgres-superuser@postgres:5432/culprit

# ---- Redis (shared by ingestion streams, anomaly/correlation state, arq) ----
REDIS_URL=redis://redis:6379

# ---- Phase 1: least-privilege DB role passwords (consumed once, by the
# migrations that CREATE ROLE — see api/migrations/versions/) ----
INGESTION_WRITER_PASSWORD=change-me-ingestion-writer
API_READER_PASSWORD=change-me-api-reader

# ---- Phase 3: ingest-gateway ----
INGEST_GATEWAY_DB_PASSWORD=change-me-ingest-gateway
INGEST_GATEWAY_DATABASE_URL=postgresql+asyncpg://ingest-gateway:change-me-ingest-gateway@postgres:5432/culprit
# Optional (Phase 14: 48c0b29fa215's migration no longer requires these —
# it skips seeding a demo service whose env var is unset instead of
# raising). Only set these if Phase 2's demo services are also deployed
# and pushing telemetry at this instance; a real install onboards its own
# services through the registry API / `just apply-services` instead (see
# the Phase 14 block below), not by editing this file or a migration.
ORDER_SERVICE_API_KEY=
INVENTORY_SERVICE_API_KEY=
PAYMENTS_SERVICE_API_KEY=

# ---- Phase 14: service registry — registry-admin role (read/write on
# components, connections, api_keys — `services`/`service_dependencies`
# until Phase 27; every other read of those tables stays on the
# read-only api-reader role above). Onboarding a component after this is
# a POST /model/components call or a `just apply-model` culprit.yaml,
# not a migration or an env var — see api/scripts/apply_model.py. ----
REGISTRY_ADMIN_DB_PASSWORD=change-me-registry-admin
REGISTRY_ADMIN_DATABASE_URL=postgresql+asyncpg://registry-admin:change-me-registry-admin@postgres:5432/culprit

# ---- Phase 15: public ingest path (frontend/Caddyfile's /ingest/* ->
# ingest-gateway) — read by both Caddy (max_size) and the gateway itself
# (api/app/ingest_gateway/config.py). INGEST_MAX_BODY_BYTES bounds the
# raw body Caddy will accept; the gateway separately bounds the
# *decompressed* size to the same number regardless of what Caddy saw,
# since it's also reachable directly on the compose network. See
# docs/SELF_HOSTED_PLAN.md's Phase 15 hardening steps. ----
INGEST_RATE_LIMIT=600/minute
# Caddy-style size string, not a bare byte count — see
# api/app/ingest_gateway/config.py's _parse_size_bytes, which parses
# this same value the same way for the gateway's own decompressed-size
# check.
INGEST_MAX_BODY_BYTES=5MB

# ---- Phase 4: anomaly detection ----
ANOMALY_DETECTOR_DB_PASSWORD=change-me-anomaly-detector
ANOMALY_DATABASE_URL=postgresql+asyncpg://anomaly-detector:change-me-anomaly-detector@postgres:5432/culprit

# ---- Phase 5: correlation engine ----
CORRELATION_ENGINE_DB_PASSWORD=change-me-correlation-engine
CORRELATION_DATABASE_URL=postgresql+asyncpg://correlation-engine:change-me-correlation-engine@postgres:5432/culprit

# ---- Phase 6: RAG + root-cause narrative ----
ROOT_CAUSE_WRITER_DB_PASSWORD=change-me-root-cause-writer
ROOT_CAUSE_DATABASE_URL=postgresql+asyncpg://root-cause-writer:change-me-root-cause-writer@postgres:5432/culprit
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
GEMINI_API_KEY=
# "gemini" (free tier) or "anthropic" — see worker/app/rag/providers/.
LLM_PROVIDER=gemini

# ---- Phase 7: dashboard API ----
API_READER_DATABASE_URL=postgresql+asyncpg://api-reader:change-me-api-reader@postgres:5432/culprit
# Same-origin in production (frontend and api are both served from
# $DOMAIN via Caddy — see frontend/Caddyfile), so browser CORS usually
# doesn't even trigger; set anyway for defense in depth / any other origin.
CORS_ALLOW_ORIGINS=https://change-me.example.com

# ---- Phase 9: JWT session auth ----
JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_EXPIRY_MINUTES=60

# ---- Phase 9/16: first-install bootstrap only. Read exactly once, by
# api/migrations/versions/fbf4cb16570a_create_users_table.py's backfill,
# to seed the very first admin row in the `users` table it creates — NOT
# read by application code at all after that (api/app/auth/config.py no
# longer imports either of these). On an existing deployment, leave them
# here and never remove them (Phase 20 cleanup, not this phase) so a
# rollback of the Phase 16 image still has a working single-operator
# fallback. On a fresh install with no operator wanted, leave both blank
# and use `just create-user` instead — see docs/SELF_HOSTED_PLAN.md
# Phase 16's rollback section for why removing these early is unsafe.
OPERATOR_USERNAME=operator
# Escape every $ as $$ — see this file's header comment; an unescaped
# hash will silently corrupt into an invalid one.
OPERATOR_PASSWORD_HASH=change-me-argon2-hash-with-dollars-escaped-as-double-dollars

# ---- Phase 17: local quickstart only — read by
# infra/docker-compose.quickstart.yml's one-shot `bootstrap` service to
# create the first admin user non-interactively (piped into
# api/scripts/create_user.py's stdin, never passed as a CLI argument).
# docker-compose.prod.yml has no `bootstrap` service and never reads
# these; leave both blank on a real install and use `just create-user`
# (which always prompts) instead — see docs/SELF_HOSTED_PLAN.md Phase 17
# Known Trap 4.
QUICKSTART_ADMIN_USERNAME=
QUICKSTART_ADMIN_PASSWORD=

# ---- Phase 16: multi-user auth — auth-service role (SELECT/INSERT/UPDATE
# on users; api-reader gets SELECT only, for require_auth's per-request
# disabled-user check). ----
AUTH_SERVICE_DB_PASSWORD=change-me-auth-service
AUTH_SERVICE_DATABASE_URL=postgresql+asyncpg://auth-service:change-me-auth-service@postgres:5432/culprit

# ---- Phase 18: postmortem write path — postmortem-writer role
# (SELECT/INSERT/UPDATE/DELETE on postmortems, SELECT on
# incident_candidates to validate a postmortem's optional incident_id).
# api-reader stays read-only for GET /postmortems; the worker's existing
# root-cause-writer role keeps writing embeddings. ----
POSTMORTEM_WRITER_DB_PASSWORD=change-me-postmortem-writer
POSTMORTEM_WRITER_DATABASE_URL=postgresql+asyncpg://postmortem-writer:change-me-postmortem-writer@postgres:5432/culprit

# ---- Phase 21 (docs/AI_NATIVE_PLAN.md): engineering memory — the shared
# bearer credential .claude/hooks/capture_ai_change.sh authenticates
# POST /ai-change-records with, since a commit-time hook has no user JWT
# to present. Optional (an unset value just means that endpoint only
# accepts a real user JWT), but generate a real one so the hook works
# out of the box. ----
AGENT_AUTOMATION_TOKEN=change-me-agent-automation-token

# ---- Phase 24 (docs/AI_NATIVE_PLAN.md): mcp-reader role — SELECT-only,
# for mcp_server/, the local stdio MCP server exposing Phase 21-23's data
# as read-only tools a coding agent can call. Not started by this
# compose file (Out of scope: no shared, multi-client deployment here) —
# a team runs mcp_server/ themselves, locally, pointed at this same
# Postgres via MCP_READER_DATABASE_URL below. ----
MCP_READER_DB_PASSWORD=change-me-mcp-reader
MCP_READER_DATABASE_URL=postgresql+asyncpg://mcp-reader:change-me-mcp-reader@postgres:5432/culprit

# ---- Phase 10: self-observability ----
# Left empty on purpose — no Tempo/Grafana deployed alongside this stack
# (self-hosting them in production is a separate decision from this
# phase; docs/IMPLEMENTATION_PLAN.md Section 7 points at Grafana Cloud's
# free tier instead). Empty means traces fall back to a console exporter
# inside the container rather than retrying a dead localhost endpoint.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# ---- Phase 28 (docs/DIAGNOSTIC_PLAN.md): the fact-writer role and the
# project token. `fact-writer` is INSERT-only on captures/intent_facts
# (plus SELECT on captures, to read one back) and has nothing at all on
# configured_facts, readings or divergences — those are Phase 30/31 and
# get their own grant decisions. CULPRIT_PROJECT_TOKEN is the bearer
# credential the `culprit` CLI presents to POST /facts/captures: an
# unattended CI run has no user session to log in with, so it is
# deliberately not a user JWT. Leave it empty and that endpoint refuses
# every request (fail closed), rather than accepting an empty token. ----
FACT_WRITER_DB_PASSWORD=change-me-fact-writer
FACT_WRITER_DATABASE_URL=postgresql+asyncpg://fact-writer:change-me-fact-writer@postgres:5432/culprit

# Phase 30: capture-writer role -- INSERT on captures/configured_facts,
# behind POST /captures. Required: its migration will not run without
# the password, and the api will not start without the URL.
CAPTURE_WRITER_DB_PASSWORD=change-me-capture-writer
CAPTURE_WRITER_DATABASE_URL=postgresql+asyncpg://capture-writer:change-me-capture-writer@postgres:5432/culprit

# Phase 31: probe-writer role -- INSERT on readings and nothing else,
# behind POST /readings. Read by both the api (the endpoint) and the
# worker (the impedance readings its anomaly job emits). Required: its
# migration will not run without the password, and neither process will
# start without the URL.
PROBE_WRITER_DB_PASSWORD=change-me-probe-writer
PROBE_WRITER_DATABASE_URL=postgresql+asyncpg://probe-writer:change-me-probe-writer@postgres:5432/culprit
CULPRIT_PROJECT_TOKEN=change-me-project-token

# ---- worker's own ingestion-writer connection ----
# Named uniquely, not DATABASE_URL — see docker-compose.prod.yml's
# per-service `environment:` overrides for why (api's migrations and
# worker's consumer both read a literal DATABASE_URL for two different
# roles; this file can't define that key twice).
WORKER_INGESTION_DATABASE_URL=postgresql+asyncpg://ingestion-writer:change-me-ingestion-writer@postgres:5432/culprit

# ---- Deployment (read by docker-compose.prod.yml / infra/deploy.sh, not app code) ----
# A real domain with a DNS A record pointing at this VM — required for
# Caddy's automatic Let's Encrypt to succeed (it cannot issue a cert for
# a bare IP).
DOMAIN=change-me.example.com
IMAGE_REGISTRY=ghcr.io/josh-heath123/culprit
# Phase 20: pin this to a released version tag (e.g. v0.1.0), not
# `latest` — a third party silently getting a new major version on
# restart is a bad default even though `latest` is convenient for the
# author's own VM. See docs/UPGRADING.md before bumping this.
IMAGE_TAG=latest
