# Production secrets for docker-compose.prod.yml — copy this to
# `.env.prod` ON THE VM ONLY (never commit the real file, never put
# these values in GitHub Actions secrets). Created once, by hand, per
# Phase 11's security requirement: the only secret CI itself needs is
# the SSH deploy key. Named .env.prod, not .env — see
# docker-compose.prod.yml's header comment for why that distinction
# actually matters here, not just style.
#
# Generate random passwords with e.g.:
#   openssl rand -base64 32
# Generate the argon2 hash for OPERATOR_PASSWORD_HASH with (from worker/ or api/):
#   uv run python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('your-password'))"
#
# IMPORTANT — escape every literal `$` in a value as `$$`. Docker
# Compose's env_file loader runs the same ${VAR} interpolation on these
# values that it runs on the compose YAML itself, so an unescaped `$` is
# silently read as the start of a variable reference (usually undefined,
# so it's silently dropped) rather than a literal character. This is not
# hypothetical: argon2 hashes are $-delimited by format
# ($argon2id$v=19$...), so OPERATOR_PASSWORD_HASH below WILL get
# corrupted into an invalid hash if you paste one in unescaped — verified
# by hitting exactly this while testing this file locally. Escaped
# example: `$argon2id$v=19$...` becomes `$$argon2id$$v=19$$...`.



# ---- Postgres superuser (also used by api/migrations/env.py for `alembic upgrade head`) ----
POSTGRES_USER=signalstack
POSTGRES_PASSWORD=change-me-postgres-superuser
POSTGRES_DB=signalstack
DASHBOARD_DATABASE_URL=postgresql+asyncpg://signalstack:change-me-postgres-superuser@postgres:5432/signalstack

# ---- Redis (shared by ingestion streams, anomaly/correlation state, arq) ----
REDIS_URL=redis://redis:6379

# ---- Phase 1: least-privilege DB role passwords (consumed once, by the
# migrations that CREATE ROLE — see api/migrations/versions/) ----
INGESTION_WRITER_PASSWORD=change-me-ingestion-writer
API_READER_PASSWORD=change-me-api-reader

# ---- Phase 3: ingest-gateway ----
INGEST_GATEWAY_DB_PASSWORD=change-me-ingest-gateway
INGEST_GATEWAY_DATABASE_URL=postgresql+asyncpg://ingest-gateway:change-me-ingest-gateway@postgres:5432/signalstack
# Only needed if Phase 2's demo services are also deployed and pushing
# telemetry at this instance — leave as placeholders otherwise, they're
# just hashed into api_keys by a migration either way.
ORDER_SERVICE_API_KEY=change-me-order-service-key
INVENTORY_SERVICE_API_KEY=change-me-inventory-service-key
PAYMENTS_SERVICE_API_KEY=change-me-payments-service-key

# ---- Phase 4: anomaly detection ----
ANOMALY_DETECTOR_DB_PASSWORD=change-me-anomaly-detector
ANOMALY_DATABASE_URL=postgresql+asyncpg://anomaly-detector:change-me-anomaly-detector@postgres:5432/signalstack

# ---- Phase 5: correlation engine ----
CORRELATION_ENGINE_DB_PASSWORD=change-me-correlation-engine
CORRELATION_DATABASE_URL=postgresql+asyncpg://correlation-engine:change-me-correlation-engine@postgres:5432/signalstack

# ---- Phase 6: RAG + root-cause narrative ----
ROOT_CAUSE_WRITER_DB_PASSWORD=change-me-root-cause-writer
ROOT_CAUSE_DATABASE_URL=postgresql+asyncpg://root-cause-writer:change-me-root-cause-writer@postgres:5432/signalstack
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
GEMINI_API_KEY=
# "gemini" (free tier) or "anthropic" — see worker/app/rag/providers/.
LLM_PROVIDER=gemini

# ---- Phase 7: dashboard API ----
API_READER_DATABASE_URL=postgresql+asyncpg://api-reader:change-me-api-reader@postgres:5432/signalstack
# Same-origin in production (frontend and api are both served from
# $DOMAIN via Caddy — see frontend/Caddyfile), so browser CORS usually
# doesn't even trigger; set anyway for defense in depth / any other origin.
CORS_ALLOW_ORIGINS=https://change-me.example.com

# ---- Phase 9: JWT session auth ----
JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_EXPIRY_MINUTES=60
OPERATOR_USERNAME=operator
# Escape every $ as $$ — see this file's header comment; an unescaped
# hash will silently corrupt into an invalid one.
OPERATOR_PASSWORD_HASH=change-me-argon2-hash-with-dollars-escaped-as-double-dollars

# ---- Phase 10: self-observability ----
# Left empty on purpose — no Tempo/Grafana deployed alongside this stack
# (self-hosting them in production is a separate decision from this
# phase; docs/IMPLEMENTATION_PLAN.md Section 7 points at Grafana Cloud's
# free tier instead). Empty means traces fall back to a console exporter
# inside the container rather than retrying a dead localhost endpoint.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# ---- worker's own ingestion-writer connection ----
# Named uniquely, not DATABASE_URL — see docker-compose.prod.yml's
# per-service `environment:` overrides for why (api's migrations and
# worker's consumer both read a literal DATABASE_URL for two different
# roles; this file can't define that key twice).
WORKER_INGESTION_DATABASE_URL=postgresql+asyncpg://ingestion-writer:change-me-ingestion-writer@postgres:5432/signalstack

# ---- Deployment (read by docker-compose.prod.yml / infra/deploy.sh, not app code) ----
# A real domain with a DNS A record pointing at this VM — required for
# Caddy's automatic Let's Encrypt to succeed (it cannot issue a cert for
# a bare IP).
DOMAIN=change-me.example.com
IMAGE_REGISTRY=ghcr.io/josh-heath123/view
IMAGE_TAG=latest
