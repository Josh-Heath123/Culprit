# This container is the whole "frontend" deployment unit — it serves the
# built SPA AND acts as the reverse proxy/TLS terminator for the api
# container. Deliberately not a separate nginx-for-statics plus
# caddy-for-TLS: Caddy already does both jobs, so a second container
# would be redundant (see docs/IMPLEMENTATION_PLAN.md Phase 11/Section 7).
#
# {$DOMAIN} must be a real domain name with a DNS A record pointing at
# the VM's IP for Caddy's automatic Let's Encrypt to succeed — it can't
# issue a certificate for a bare IP. Defaults to localhost (which Caddy
# serves over plain HTTP with a locally-trusted cert, not a real one) so
# this Caddyfile is still usable for a local `docker compose` smoke test
# without a domain.
{$DOMAIN:localhost} {
	encode gzip

	# Stripped, not forwarded: the api container's routers are mounted at
	# root (/incidents, /auth/login, ...), not under /api — handle_path
	# removes the /api prefix before proxying, so the app code needs no
	# change for this routing choice.
	handle_path /api/* {
		reverse_proxy api:8000
	}

	# Phase 15: the public ingest path — a third party's own services,
	# running elsewhere, point OTEL_EXPORTER_OTLP_ENDPOINT at
	# https://{$DOMAIN}/ingest and land here. Stripped the same way /api/*
	# is: a client configured with .../ingest sends to /ingest/v1/metrics,
	# ingest-gateway sees /v1/metrics, no application change. max_size is
	# deliberately inside this route block, not at the site level (Known
	# Trap 2, docs/SELF_HOSTED_PLAN.md Phase 15) — putting it outside
	# would cap the dashboard's own requests to the same limit. This is
	# the *raw*, possibly-still-gzipped body Caddy itself ever sees; the
	# gateway's own defensive check (app/ingest_gateway/main.py's
	# _maybe_decompress) is what actually bounds the decompressed size —
	# a small gzip bomb would sail under this cap entirely.
	handle_path /ingest/* {
		request_body {
			max_size {$INGEST_MAX_BODY_BYTES:5MB}
		}
		reverse_proxy ingest-gateway:8010
	}

	handle {
		root * /srv
		file_server
		try_files {path} /index.html
	}
}
