{
  "why": [
    "The statement rule (Phase 37 part 2): integer comparison of a window's total execution time against budget_ms * 1000 * calls, per statement. cli/internal/model/statements.go (JudgeStatements) and shared/culprit_model/statements.py (judge_statements) give each case's verdict and reason, or both refuse its shape (error)."
  ],
  "cases": [
    {
      "why": "over budget: 5 calls, 260 ms in all, against 50 ms",
      "measured": {
        "reset_during_window": false,
        "statements": [
          {
            "queryid": "101",
            "calls": 5,
            "total_us": 260000,
            "budget_ms": 50
          }
        ]
      },
      "verdict": "fail",
      "reason": "statement 101 is over its 50 ms budget: 260000 µs over 5 call(s) in the window, more than 50 ms each"
    },
