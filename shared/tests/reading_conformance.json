      "discriminates": [],
      "cost": "cheap",
      "verdicts": ["pass", "fail", "inconclusive", "refused"]
    },
    {"id": "probe.db.plan", "version": 1, "effect": "inspect", "capabilities": ["db.plan.read"], "timeout_ms": 20000, "expected_from": null, "produces": [], "discriminates": [], "cost": "cheap", "verdicts": ["pass", "inconclusive", "refused"]},
    {"id": "probe.auth.token_shape", "version": 3, "effect": "inspect", "capabilities": [], "timeout_ms": 2000, "expected_from": "INTENT", "produces": [], "discriminates": [], "cost": "cheap", "verdicts": ["pass", "fail", "inconclusive", "refused"]}
  ],
