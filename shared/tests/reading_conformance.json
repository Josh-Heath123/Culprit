    {"why": "a verdict outside the four", "manifest": {"id": "probe.net.ping", "version": 1, "effect": "inspect", "capabilities": [], "timeout_ms": 1000, "verdicts": ["pass", "inconclusive", "maybe"]}},
    {"why": "a verdict declared twice", "manifest": {"id": "probe.net.ping", "version": 1, "effect": "inspect", "capabilities": [], "timeout_ms": 1000, "verdicts": ["pass", "pass", "inconclusive"]}},
    {"why": "every probe declares inconclusive - a probe that cannot admit uncertainty is a probe that guesses", "manifest": {"id": "probe.net.ping", "version": 1, "effect": "inspect", "capabilities": [], "timeout_ms": 1000, "verdicts": ["pass", "fail"]}},
    {"why": "a probe that needs a capability declares refused, which the runner returns when it is not granted", "manifest": {"id": "probe.net.tcp_connect", "version": 1, "effect": "inspect", "capabilities": ["net.tcp.connect"], "timeout_ms": 2000, "verdicts": ["pass", "fail", "inconclusive"]}}
  ],
