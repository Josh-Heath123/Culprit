    {"why": "discriminates names a hypothesis kind the isolation walk does not know", "manifest": {"id": "probe.net.tcp_connect", "version": 1, "effect": "inspect", "capabilities": ["net.tcp.connect"], "timeout_ms": 2000, "expected_from": "CONFIGURED", "produces": [{"subject_template": "connection:{from}->{to}", "predicate": "tcp_connects"}], "discriminates": ["it_feels_slow"], "cost": "cheap", "verdicts": ["pass", "fail", "inconclusive", "refused"]}},
    {"why": "a probe lists the verdicts it can return (Q31)", "manifest": {"id": "probe.net.ping", "version": 1, "effect": "inspect", "capabilities": [], "timeout_ms": 1000}},
