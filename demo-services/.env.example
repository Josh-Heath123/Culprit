# Must match the values in api/.env — those are what got hashed into the
# api_keys table.
ORDER_SERVICE_API_KEY=change-me-order-service-key
INVENTORY_SERVICE_API_KEY=change-me-inventory-service-key
PAYMENTS_SERVICE_API_KEY=change-me-payments-service-key

# ingest-gateway (Phase 3) only accepts metrics and logs — set these
# signal-specific vars, not the generic OTEL_EXPORTER_OTLP_ENDPOINT, so
# traces don't also get redirected there (it has no /v1/traces). Traces
# fall back to the console exporter unless OTEL_EXPORTER_OTLP_TRACES_ENDPOINT
# is set separately (e.g. to Tempo, for local viewing).
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:8010
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:8010
