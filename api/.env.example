DATABASE_URL=postgresql+asyncpg://signalstack:signalstack@localhost:5432/signalstack
INGESTION_WRITER_PASSWORD=change-me-ingestion-writer
API_READER_PASSWORD=change-me-api-reader

# Phase 3: ingest-gateway
INGEST_GATEWAY_DB_PASSWORD=change-me-ingest-gateway
INGEST_GATEWAY_DATABASE_URL=postgresql+asyncpg://ingest-gateway:change-me-ingest-gateway@localhost:5432/signalstack
REDIS_URL=redis://localhost:6379

# Three fixed, manually-provisioned demo-service API keys — copy the same
# values into demo-services/.env so each service can present its own key.
ORDER_SERVICE_API_KEY=change-me-order-service-key
INVENTORY_SERVICE_API_KEY=change-me-inventory-service-key
PAYMENTS_SERVICE_API_KEY=change-me-payments-service-key

# Phase 4: anomaly detection
ANOMALY_DETECTOR_DB_PASSWORD=change-me-anomaly-detector

# Phase 5: correlation engine
CORRELATION_ENGINE_DB_PASSWORD=change-me-correlation-engine

# Phase 6: RAG + root-cause narrative
ROOT_CAUSE_WRITER_DB_PASSWORD=change-me-root-cause-writer

# Phase 7: dashboard API (app/main.py) — api-reader role, read-only.
API_READER_DATABASE_URL=postgresql+asyncpg://api-reader:change-me-api-reader@localhost:5432/signalstack
CORS_ALLOW_ORIGINS=http://localhost:5173

# Phase 9 (minimal prerequisite for Phase 10): JWT session auth. Single
# hardcoded operator credential, not a users table — see app/auth/config.py.
# Generate a hash with: uv run python -c "from argon2 import PasswordHasher;
# print(PasswordHasher().hash('your-password'))"
JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_EXPIRY_MINUTES=60
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD_HASH=change-me-argon2-hash

# Phase 10: self-observability — OTel traces to Tempo (infra/docker-compose.yml).
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318
