DATABASE_URL=postgresql+asyncpg://signalstack:signalstack@localhost:5432/signalstack
INGESTION_WRITER_PASSWORD=change-me-ingestion-writer
API_READER_PASSWORD=change-me-api-reader

# Phase 3: ingest-gateway
INGEST_GATEWAY_DB_PASSWORD=change-me-ingest-gateway
INGEST_GATEWAY_DATABASE_URL=postgresql+asyncpg://ingest-gateway:change-me-ingest-gateway@localhost:5432/signalstack
REDIS_URL=redis://localhost:6379

# Three fixed, manually-provisioned demo-service API keys — copy the same
# values into demo-services/.env so each service can present its own key.
ORDER_SERVICE_API_KEY=change-me-order-service-key
INVENTORY_SERVICE_API_KEY=change-me-inventory-service-key
PAYMENTS_SERVICE_API_KEY=change-me-payments-service-key

# Phase 4: anomaly detection
ANOMALY_DETECTOR_DB_PASSWORD=change-me-anomaly-detector

# Phase 5: correlation engine
CORRELATION_ENGINE_DB_PASSWORD=change-me-correlation-engine

# Phase 6: RAG + root-cause narrative
ROOT_CAUSE_WRITER_DB_PASSWORD=change-me-root-cause-writer

# Phase 7: dashboard API (app/main.py) — api-reader role, read-only.
API_READER_DATABASE_URL=postgresql+asyncpg://api-reader:change-me-api-reader@localhost:5432/signalstack
CORS_ALLOW_ORIGINS=http://localhost:5173

# Phase 9 (minimal prerequisite for Phase 10): JWT session auth. Single
# hardcoded operator credential, not a users table — see app/auth/config.py.
# Generate a hash with: uv run python -c "from argon2 import PasswordHasher;
# print(PasswordHasher().hash('your-password'))"
JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_EXPIRY_MINUTES=60
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD_HASH=change-me-argon2-hash

# Phase 10: self-observability — OTel traces to Tempo (infra/docker-compose.yml).
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318

# Phase 14: service registry — registry-admin role (SELECT/INSERT/UPDATE/
# DELETE on services, service_dependencies, api_keys). The DB_PASSWORD is
# read by the migration that creates the role; the DATABASE_URL is read by
# app/registry/config.py at import time and has no fallback (Phase 26).
REGISTRY_ADMIN_DB_PASSWORD=change-me-registry-admin
REGISTRY_ADMIN_DATABASE_URL=postgresql+asyncpg://registry-admin:change-me-registry-admin@localhost:5432/signalstack

# Phase 16: multi-user auth — auth-service role (SELECT/INSERT/UPDATE on
# users). OPERATOR_USERNAME/OPERATOR_PASSWORD_HASH above are now read only
# by fbf4cb16570a's one-time backfill, never by application code.
AUTH_SERVICE_DB_PASSWORD=change-me-auth-service
AUTH_SERVICE_DATABASE_URL=postgresql+asyncpg://auth-service:change-me-auth-service@localhost:5432/signalstack

# Phase 18: postmortem write path — postmortem-writer role, extended in
# Phase 21 to cover architecture_decisions and ai_change_records.
POSTMORTEM_WRITER_DB_PASSWORD=change-me-postmortem-writer
POSTMORTEM_WRITER_DATABASE_URL=postgresql+asyncpg://postmortem-writer:change-me-postmortem-writer@localhost:5432/signalstack

# Phase 24: the MCP server's read-only role. Its DATABASE_URL is read by
# mcp_server/config.py, which is a separate uv project — this entry is
# here because the password is what the migration creating the role needs.
MCP_READER_DB_PASSWORD=change-me-mcp-reader
MCP_READER_DATABASE_URL=postgresql+asyncpg://mcp-reader:change-me-mcp-reader@localhost:5432/signalstack

# Phase 21: the shared bearer credential .claude/hooks/capture_ai_change.sh
# presents to POST /ai-change-records. Optional — unset simply means the
# agent-auth path never matches.
AGENT_AUTOMATION_TOKEN=change-me-agent-automation-token

# Phase 28: the fact-writer role (INSERT on captures/intent_facts, SELECT
# on captures) and the project token POST /facts/captures authenticates
# with. An empty token means that endpoint refuses everything.
FACT_WRITER_DB_PASSWORD=change-me-fact-writer
FACT_WRITER_DATABASE_URL=postgresql+asyncpg://fact-writer:change-me-fact-writer@localhost:5432/signalstack
CULPRIT_PROJECT_TOKEN=change-me-project-token
