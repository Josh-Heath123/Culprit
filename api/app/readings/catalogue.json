  {
    "id": "probe.auth.propagation",
    "version": 1,
    "effect": "interrogate",
    "capabilities": [
      "net.http.outbound"
    ],
    "inputs": {
      "properties": {
        "token": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "token"
      ],
      "type": "object"
    },
    "timeout_ms": 15000,
    "expected_from": "INTENT",
    "produces": [
      {
        "subject_template": "auth:{from}-\u003e{to}/propagation",
        "predicate": "token_accepted"
      }
    ],
    "discriminates": [
      "auth_rejected"
    ],
    "cost": "cheap",
    "verdicts": [
      "pass",
      "fail",
      "inconclusive",
      "refused"
    ]
  },
